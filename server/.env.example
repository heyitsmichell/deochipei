# NVIDIA NIM API Configuration
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_VISION_FALLBACK_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b
NVIDIA_DUPLICATES_MODEL=meta/llama-3.3-70b-instruct

# Supabase Authentication & PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
# Modern publishable key (sb_publishable_...) or legacy anon key (eyJ...)
SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

PORT=4000

# Optional: invite links (https://<this server>/join/<code>) open the app directly
# once universal links / app links are verified. See README "Invites".
# APP_SCHEME=deochipei
# IOS_APP_ID=ABCDE12345.com.deochipei
# ANDROID_PACKAGE=com.deochipei
# ANDROID_CERT_SHA256=AA:BB:...
