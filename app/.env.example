# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Modern Publishable Key (sb_publishable_...) or legacy anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Custom API URL (defaults to http://localhost:4000 in dev)
# EXPO_PUBLIC_API_URL=https://your-server.example.com

# Optional: Universal Link URL for invites
# EXPO_PUBLIC_INVITE_URL=https://your-server.example.com
